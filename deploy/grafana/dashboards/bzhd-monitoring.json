        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Уведомления по типам и статусам",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "ag539naj617uob"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT event_type, status, total\nFROM (\n    SELECT\n        event_type,\n        status,\n        COUNT(*)::bigint AS total\n    FROM notifications\n    WHERE $__timeFilter(created_at)\n    GROUP BY event_type, status\n\n    UNION ALL\n\n    SELECT\n        'Нет уведомлений'::text,\n        '—'::text,\n        0::bigint\n    WHERE NOT EXISTS (\n        SELECT 1\n        FROM notifications\n        WHERE $__timeFilter(created_at)\n    )\n) AS notification_stats\nORDER BY total DESC",
          "datasource": {
            "type": "postgres",
            "uid": "ag539naj617uob"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Активные подписки по направлениям",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "ag539naj617uob"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "\n            SELECT\n                m.from_name AS \"Откуда\",\n                m.to_name AS \"Куда\",\n                m.travel_date AS \"Дата поездки\",\n                COUNT(s.id)::bigint AS \"Подписок\",\n                COALESCE(SUM(s.tickets_count), 0)::bigint AS \"Билетов\"\n            FROM monitors m\n            LEFT JOIN subscriptions s\n                ON s.monitor_key = m.key AND s.is_active = TRUE\n            WHERE m.is_active = TRUE\n            GROUP BY m.key, m.from_name, m.to_name, m.travel_date\n            ORDER BY COUNT(s.id) DESC\n        ",
          "datasource": {
            "type": "postgres",
            "uid": "ag539naj617uob"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
