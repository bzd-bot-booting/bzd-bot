    {
      "id": 7,
      "title": "Регистрация пользователей",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "ag539naj617uob"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n    days.day AS \"time\",\n    COUNT(u.created_at)::bigint AS users\nFROM generate_series(\n    date_trunc('day', $__timeFrom()::timestamptz),\n    date_trunc('day', $__timeTo()::timestamptz),\n    interval '1 day'\n) AS days(day)\nLEFT JOIN users u\n    ON u.created_at >= days.day\n    AND u.created_at < days.day + interval '1 day'\n    AND u.created_at >= $__timeFrom()\n    AND u.created_at <= $__timeTo()\nGROUP BY days.day\nORDER BY days.day",
          "datasource": {
            "type": "postgres",
            "uid": "ag539naj617uob"
          },
          "alias": "Новые пользователи"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
