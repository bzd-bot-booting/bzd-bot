          "rawSql": "\n            SELECT\n                created_at AS \"Создано\",\n                from_name AS \"Откуда\",\n                to_name AS \"Куда\",\n                travel_date AS \"Дата поездки\",\n                train_number AS \"Поезд\",\n                status AS \"Статус\",\n                attempt_count AS \"Попытки\"\n            FROM booking_jobs\n            ORDER BY created_at DESC\n            LIMIT 50\n        ",
          "datasource": {
            "type": "postgres",
            "uid": "ag539naj617uob"
          }
