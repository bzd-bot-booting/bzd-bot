      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "\n            SELECT status, COUNT(*)::bigint AS total\n            FROM booking_jobs\n            GROUP BY status\n            ORDER BY total DESC\n        ",
          "datasource": {
            "type": "postgres",
            "uid": "ag539naj617uob"
          }
        }
      ],
      "options": {
