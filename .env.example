# ==========================================
# TELEGRAM BOT
# ==========================================

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_CHAT_IDS=

# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_DB=bzhd_bot
POSTGRES_USER=bzhd_bot
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Для локального запуска и режима bot-only.
# В Docker Compose основной конфигурации адрес БД
# автоматически формируется через сервис postgres.
DATABASE_URL=postgresql+asyncpg://bzhd_bot:CHANGE_ME_TO_A_STRONG_PASSWORD@localhost:5432/bzhd_bot

# ==========================================
# ENCRYPTION
# ==========================================

# Сгенерировать командой:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

BOOKING_ENCRYPTION_KEY=GENERATE_FERNET_KEY

# ==========================================
# BOOKING AND MONITORING
# ==========================================

CHECK_INTERVAL=30
MAX_TICKETS_PER_REQUEST=9
PLAYWRIGHT_HEADLESS=true
PAGE_TIMEOUT_MS=90000
PAGE_WAIT_MS=2000

# Часовой пояс расписания поездов
TRAIN_TIMEZONE=Europe/Minsk

# ==========================================
# EMAIL / SMTP (OPTIONAL)
# ==========================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
SMTP_ERROR_COOLDOWN_SECONDS=900

EMAIL_FROM=
EMAIL_TO=

# ==========================================
# DAILY REPORTS
# ==========================================

REPORT_TIMEZONE=Europe/Vilnius
REPORT_HOUR=9
REPORT_MINUTE=0

# ==========================================
# LOGGING AND HEALTHCHECK
# ==========================================

SERVICE_NAME=bzhd_bot
LOG_LEVEL=INFO
AIOGRAM_LOG_LEVEL=INFO
LOG_FILE=
HEALTH_FILE=/tmp/bzhd_bot_heartbeat
HEALTH_INTERVAL_SECONDS=30

# ==========================================
# GRAFANA
# ==========================================

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_TO_ANOTHER_STRONG_PASSWORD

# ==========================================
# TIMEZONE
# ==========================================

TZ=Europe/Vilnius
